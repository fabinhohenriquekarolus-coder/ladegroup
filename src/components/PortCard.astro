---
const { title, text, gradient, href } = Astro.props;
---

<article class="port-card">
  <div class="port-thumb" style={`background:${gradient}`}>
    <span class="port-tag">Demonstração</span>
    <div class="swatch">
      <svg viewBox="0 0 56 56" aria-hidden="true">
        <polygon
          points="54,28 41,50.5 15,50.5 2,28 15,5.5 41,5.5"
          fill="none"
          stroke="#fff"
          stroke-width="2"></polygon>
        <polygon
          points="41,28 34.5,39.3 21.5,39.3 15,28 21.5,16.7 34.5,16.7"
          fill="none"
          stroke="#fff"
          stroke-width="2"></polygon>
      </svg>
    </div>
  </div>
  <div class="port-body">
    <h3>{title}</h3>
    <p>{text}</p>
    {
      href && (
        <a class="btn btn-secondary btn-sm" href={href} target="_blank" rel="noopener">
          Ver o site
        </a>
      )
    }
  </div>
</article>
