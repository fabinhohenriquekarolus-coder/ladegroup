---
import WhatsAppButton from './WhatsAppButton.astro';

const { title, text, origin } = Astro.props;
---

<section class="band">
  <div class="container band-inner">
    <div class="band-copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <WhatsAppButton variant="light" origin={origin} />
  </div>
</section>
