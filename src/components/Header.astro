---
import Logo from './Logo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { navItems, site } from '../data/site.js';

const { current } = Astro.props;
---

<header class="nav">
  <div class="nav-inner container">
    <a href="/" class="nav-brand">
      <Logo />
      <span>{site.brand}</span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-burger"
      ><span class="sr-only">Abrir menu</span><span class="nav-burger-icon"></span></label
    >
    <nav class="nav-panel" aria-label="Principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={{ 'is-active': item.key === current }}
            aria-current={item.key === current ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <WhatsAppButton small />
    </nav>
  </div>
</header>
