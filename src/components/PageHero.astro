---
const { eyebrow, title, lead, short = false, borderless = false } = Astro.props;
---

<section class:list={['page-hero', { 'is-short': short, 'is-borderless': borderless }]}>
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
  </div>
</section>
