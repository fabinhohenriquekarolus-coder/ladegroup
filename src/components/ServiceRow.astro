---
import HexFrame from './HexFrame.astro';
import Icon from './Icon.astro';

const { icon, num, title, checklist } = Astro.props;
---

<div class="service-row">
  <div class="service-row-head">
    <HexFrame><Icon name={icon} /></HexFrame>
    <div>
      <span class="service-num">{num}</span>
      <h2 class="service-title">{title}</h2>
    </div>
  </div>
  <div>
    <p class="lead"><slot /></p>
    <ul class="service-checklist">
      {
        checklist.map((item) => (
          <li>
            <Icon name="check" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</div>
