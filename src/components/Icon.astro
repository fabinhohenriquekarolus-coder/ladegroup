---
import { icons } from '../data/icons.js';

const { name } = Astro.props;
const { markup, strokeWidth = 2 } = icons[name];
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <Fragment set:html={markup} />
</svg>
