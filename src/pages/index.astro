---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import HexFrame from '../components/HexFrame.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const builds = [
  {
    icon: 'whatsapp',
    title: 'Bot de atendimento no WhatsApp',
    text: 'Responde na hora, qualifica o contato e passa para você só quem está pronto para fechar, inclusive fora do expediente.',
  },
  {
    icon: 'bars',
    title: 'Painel de gestão',
    text: 'Veja agendamentos, clientes e números do negócio num lugar só, sem depender de planilha manual.',
  },
  {
    icon: 'nodes',
    title: 'Sistema sob medida',
    text: 'O fluxo que é só do seu negócio, desenhado a partir da sua rotina.',
  },
];

const steps = [
  { num: '01', title: 'Conversa', text: 'Entendemos a sua rotina e onde o tempo se perde.' },
  { num: '02', title: 'Proposta', text: 'Definimos o que entra primeiro e quanto custa.' },
  { num: '03', title: 'Desenvolvimento', text: 'Construímos e mostramos o andamento.' },
  {
    num: '04',
    title: 'Entrega e evolução',
    text: 'Colocamos no ar, ensinamos a usar e seguimos ajustando.',
  },
];

const reasons = [
  { title: 'Time local', text: 'Você fala com gente de Joinville.' },
  {
    title: 'Resposta direto no WhatsApp',
    text: 'Sem formulário que ninguém responde depois. Você manda mensagem e a gente responde.',
  },
  { title: 'Sistema que a gente mesmo usa', text: 'O LaCar é produto próprio em produção.' },
];
---

<BaseLayout
  title="Lade Group | Sistemas sob medida e automação em Joinville"
  description="A Lade Group desenvolve sistemas sob medida, bot de atendimento no WhatsApp e painéis de gestão para negócios de Joinville e região."
  path="/"
  origin="home"
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>Sistemas feitos sob medida para o seu negócio funcionar melhor.</h1>
        <p class="lead">
          Ainda roda em planilha e mensagem solta? A gente resolve. Desenvolvemos bot de atendimento
          no WhatsApp, painéis de gestão e sistemas sob medida, aqui em Joinville e região.
        </p>
        <div class="hero-ctas">
          <WhatsAppButton origin="home" />
          <a class="btn btn-secondary" href="/portfolio.html">Ver o que já fizemos</a>
        </div>
        <div class="hero-meta">
          <span class="dot"></span> Atendemos Joinville e região. Resposta direto no WhatsApp.
        </div>
      </div>
      <div class="reticle" aria-hidden="true">
        <Logo />
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="container">
      <div class="section-head">
        <h2>O que a gente constrói para o seu negócio</h2>
      </div>
      <div class="feature-list">
        {
          builds.map((item) => (
            <div class="feature-item">
              <HexFrame>
                <Icon name={item.icon} />
              </HexFrame>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="container">
      <div class="product-feature is-brand">
        <h2>LaCar: o nosso sistema, em produção</h2>
        <p>
          Bot de WhatsApp e painel de gestão para lava-rápidos e estéticas automotivas. Já roda no
          dia a dia desses negócios.
        </p>
        <a class="btn btn-primary" href="/portfolio.html#lacar">Conhecer o LaCar</a>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <div class="section-head">
        <h2>Como a gente trabalha</h2>
      </div>
      <div class="grid-4">
        {
          steps.map((step) => (
            <div class="process-card">
              <HexFrame filled>
                <span class="num">{step.num}</span>
              </HexFrame>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="offer-strip">
    <div class="container offer-strip-inner">
      <p>
        Também cuidamos da sua presença online: sites e landing pages, tráfego pago e Google Meu
        Negócio.
      </p>
      <a class="btn btn-secondary btn-sm" href="/servicos.html#presenca">Ver ofertas</a>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <h2>Diferença que dá pra sentir na conversa</h2>
      </div>
      <div class="reasons">
        {
          reasons.map((reason) => (
            <div class="reason">
              <h3>{reason.title}</h3>
              <p>{reason.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    origin="home"
    title="Qual parte da sua rotina ainda depende de planilha?"
    text="Conta pra gente pelo WhatsApp. A conversa é direta e sem compromisso."
  />
</BaseLayout>
