---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Portfólio — Lade Group"
  description="O LaCar, sistema próprio da Lade Group em produção, e demonstrações do que podemos criar para o seu negócio."
  path="/portfolio.html"
  current="portfolio"
>
  <PageHero
    title="O que a gente constrói, funcionando"
    lead="O LaCar é o nosso sistema próprio, em produção."
  />

  <section class="tight" id="lacar">
    <div class="container">
      <div class="product-feature is-brand">
        <span class="eyebrow-alt">Produto próprio · em produção</span>
        <h2>LaCar</h2>
        <p>
          Bot de WhatsApp + painel de gestão para lava-rápido e estética automotiva. A gente não só
          recomenda automação pros clientes — constrói e mantém a nossa própria, rodando de verdade.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Quer ver o seu negócio aqui?"
    text="É assim que começa: uma conversa no WhatsApp e um diagnóstico do que já existe hoje."
  />
</BaseLayout>
