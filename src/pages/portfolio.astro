---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import DemoCard from '../components/DemoCard.astro';
import PageHero from '../components/PageHero.astro';
import { systemDemos } from '../data/demos/index.js';
---

<BaseLayout
  title="Portfólio — Lade Group"
  description="O LaCar, sistema próprio da Lade Group em produção, e demonstrações de sistemas com dados fictícios para você ver o que podemos criar."
  path="/portfolio.html"
  current="portfolio"
>
  <PageHero
    title="O que a gente constrói, funcionando"
    lead="O LaCar está em produção. Os sistemas abaixo são demonstrações com dados fictícios, feitas para você ver como o seu negócio poderia ficar."
  />

  <section class="tight" id="lacar">
    <div class="container">
      <div class="product-feature is-brand">
        <span class="eyebrow-alt">Produto próprio · em produção</span>
        <h2>LaCar</h2>
        <p>
          Bot de WhatsApp + painel de gestão para lava-rápido e estética automotiva. A gente não só
          recomenda automação pros clientes — constrói e mantém a nossa própria, rodando de verdade.
        </p>
      </div>
    </div>
  </section>

  <section class="tight section-alt" id="sistemas">
    <div class="container">
      <div class="section-head">
        <h2>Sistemas exemplo</h2>
        <p>Clique, navegue e teste. Tudo o que aparece é fictício e funciona só no seu navegador.</p>
      </div>
      <div class="grid-2">
        {systemDemos.map((demo) => <DemoCard {...demo} />)}
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="container">
      <div class="demo-notice">
        <h3>Sobre as demonstrações</h3>
        <p>
          Marcas, nomes, números e dados das demonstrações são fictícios e foram criados pela Lade
          Group apenas para mostrar o que podemos desenvolver. Qualquer semelhança com empresas ou
          pessoas reais é coincidência.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Quer algo assim para o seu negócio?"
    text="Conta o que o seu negócio precisa e a gente indica por onde começar."
  />
</BaseLayout>
