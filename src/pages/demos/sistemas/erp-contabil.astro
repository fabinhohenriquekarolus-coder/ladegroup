---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import '../../../styles/demos/razao.css';

const menu = ['Arquivo', 'Cadastros', 'Fiscal', 'Folha', 'Relatórios', 'Ajuda'];
const tabs = [
  ['lancamentos', 'Lançamentos'],
  ['obrigacoes', 'Obrigações'],
  ['documentos', 'Documentos'],
];
---

<DemoLayout
  title="ERP contábil com IA (demonstração) — Lade Group"
  description="Demonstração com dados fictícios de um ERP contábil com lançamentos, obrigações, documentos e conferência por IA simulada."
  kind="sistema"
  name="ERP contábil com IA"
>
  <div class="rz" id="rz">
    <div class="rz-titlebar">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" fill="none" stroke="#fff" stroke-width="2"></rect>
        <path d="M7 9h10M7 13h10M7 17h6" stroke="#f2b705" stroke-width="2"></path>
      </svg>
      Razão · Escritório Exemplo
      <span class="rz-comp">Competência 09/2026</span>
    </div>
    <nav class="rz-menu" aria-label="Menu do sistema">
      {menu.map((item) => <button type="button" data-demo-action="Nesta demonstração, só a tela principal é navegável.">{item}</button>)}
    </nav>
    <div class="rz-toolbar" role="toolbar" aria-label="Ferramentas">
      <button type="button" class="tbtn" data-demo-action="O lançamento manual não funciona nesta demonstração.">Novo lançamento</button>
      <button type="button" class="tbtn" data-demo-action="Nada é salvo nesta demonstração.">Salvar</button>
      <span class="rz-sep"></span>
      <button type="button" class="tbtn is-primary" data-check>Conferir com IA</button>
      <span class="rz-sim">Simulação</span>
      <label class="rz-comp-select">Competência
        <select aria-label="Competência">
          <option>09/2026</option>
        </select>
      </label>
    </div>
    <div class="rz-body">
      <aside class="rz-side" aria-label="Clientes">
        <h2>Clientes</h2>
        <ul id="rz-tree"></ul>
      </aside>
      <section class="rz-work">
        <div class="rz-tabs" role="tablist" aria-label="Áreas de trabalho">
          {
            tabs.map(([id, label], index) => (
              <button type="button" role="tab" data-tab={id} aria-selected={index === 0 ? 'true' : 'false'}>
                {label}
              </button>
            ))
          }
        </div>
        <div class="rz-view" id="rz-view" role="tabpanel"></div>
      </section>
      <aside class="rz-inspector" id="rz-inspector" aria-live="polite"></aside>
    </div>
    <footer class="rz-status" id="rz-status"></footer>
  </div>

  <script>
    import '../../../scripts/demos/erp.js';
  </script>
</DemoLayout>
