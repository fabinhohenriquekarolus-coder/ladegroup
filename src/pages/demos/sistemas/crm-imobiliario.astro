---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import '../../../styles/demos/cumeeira.css';

const nav = [
  ['Funil', true],
  ['Imóveis', false],
  ['Agenda', false],
  ['Relatórios', false],
];
---

<DemoLayout
  title="CRM imobiliário com IA (demonstração) — Lade Group"
  description="Demonstração com dados fictícios de um CRM imobiliário com funil de vendas, conversa e assistente de IA simulado."
  kind="sistema"
  name="CRM imobiliário com IA"
>
  <div class="cum">
    <header class="cum-top">
      <div class="cum-top-inner">
        <div class="cum-logo">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M3 16 16 5l13 11" fill="none" stroke="#b8862b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M7 15v12h18V15" fill="none" stroke="#fff" stroke-width="2.4" stroke-linejoin="round"></path>
            <rect x="13.5" y="19" width="5" height="8" fill="#b8862b"></rect>
          </svg>
          Cumeeira
        </div>
        <nav class="cum-nav" aria-label="Menu do sistema">
          {
            nav.map(([label, active]) =>
              active ? (
                <button type="button" aria-current="page">{label}</button>
              ) : (
                <button type="button" data-demo-action="Nesta demonstração, só o funil é navegável.">{label}</button>
              ),
            )
          }
        </nav>
        <button type="button" class="cum-search" data-demo-action="A busca não funciona nesta demonstração.">Buscar contato ou imóvel</button>
        <span class="cum-user" aria-hidden="true">CM</span>
      </div>
    </header>

    <section class="cum-stats" id="stats" aria-label="Indicadores"></section>

    <main class="cum-main">
      <div class="cum-title">
        <h1>Funil de vendas</h1>
        <p>Imobiliária Exemplo · arraste os cartões entre as etapas ou clique para abrir o contato</p>
      </div>
      <div class="cum-board" id="board"></div>
    </main>

    <div class="cum-scrim" id="scrim" hidden></div>
    <aside class="cum-drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true"></aside>
  </div>

  <script>
    import '../../../scripts/demos/crm.js';
  </script>
</DemoLayout>
