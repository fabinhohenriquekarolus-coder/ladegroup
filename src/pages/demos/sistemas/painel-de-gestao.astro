---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import '../../../styles/demos/mare.css';

const periods = [
  ['7', '7 dias'],
  ['30', '30 dias'],
  ['90', '90 dias'],
];
---

<DemoLayout
  title="Painel de gestão (demonstração) — Lade Group"
  description="Demonstração com dados fictícios de um painel de gestão com faturamento, canais de venda, mapa de calor, metas e pedidos."
  kind="sistema"
  name="Painel de gestão"
>
  <div class="mare">
    <header class="mare-top">
      <div class="mare-top-inner">
      <div class="mare-logo">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="20" fill="#2b1240"></circle>
          <path d="M6 24c4-6 7-6 11 0s7 6 11 0 5-5 6-4" fill="none" stroke="#ff5c7a" stroke-width="3.2" stroke-linecap="round"></path>
          <path d="M6 16c4-6 7-6 11 0s7 6 11 0 5-5 6-4" fill="none" stroke="#ffb199" stroke-width="3.2" stroke-linecap="round" opacity=".7"></path>
        </svg>
        Maré
      </div>
      <nav class="mare-nav" aria-label="Seções">
        <a href="#resumo">Resumo</a>
        <a href="#canais">Canais</a>
        <a href="#horarios">Horários</a>
        <a href="#pedidos">Pedidos</a>
      </nav>
      <div class="mare-period" role="group" aria-label="Período">
        {periods.map(([key, label]) => <button type="button" data-period={key} aria-pressed={key === '7' ? 'true' : 'false'}>{label}</button>)}
      </div>
      </div>
    </header>

    <main class="mare-page">
      <section class="card hero" id="resumo" aria-labelledby="hero-label">
        <span class="hero-label" id="hero-label">Faturamento</span>
        <strong class="hero-total" id="hero-total">R$ 0</strong>
        <span class="hero-delta" id="hero-delta"></span>
        <div class="hero-stats">
          <div><span>Pedidos</span><strong id="hero-orders" class="mono"></strong></div>
          <div><span>Ticket médio</span><strong id="hero-ticket" class="mono"></strong></div>
          <div><span>Clientes novos</span><strong id="hero-customers" class="mono"></strong></div>
        </div>
        <div class="chart" id="chart"></div>
      </section>

      <div class="side">
        <section class="card today">
          <h2>Pedido chegando?</h2>
          <p>Veja o painel reagir quando entra uma venda nova.</p>
          <button type="button" class="btn-sim" id="simulate">Simular novo pedido</button>
        </section>
        <section class="card" aria-labelledby="titulo-metas">
          <h2 id="titulo-metas">Metas do mês</h2>
          <ul class="goals" id="goals"></ul>
        </section>
      </div>

      <section class="card channels" id="canais" aria-labelledby="titulo-canais">
        <h2 id="titulo-canais">Canais de venda</h2>
        <div class="donut-wrap" id="donut"></div>
      </section>

      <section class="card heatmap" id="horarios" aria-labelledby="titulo-heat">
        <h2 id="titulo-heat">Quando as vendas acontecem</h2>
        <div id="heat"></div>
        <p class="heat-note" id="heat-note">Passe o mouse ou foque em um horário para ver o faturamento.</p>
      </section>

      <section class="card ranking" aria-labelledby="titulo-top">
        <h2 id="titulo-top">Mais vendidos</h2>
        <ol class="top" id="top"></ol>
      </section>

      <section class="card live" id="pedidos" aria-labelledby="titulo-feed">
        <h2 id="titulo-feed">Pedidos recentes</h2>
        <ul class="feed" id="feed"></ul>
      </section>
    </main>
  </div>

  <script>
    import '../../../scripts/demos/painel.js';
  </script>
</DemoLayout>
