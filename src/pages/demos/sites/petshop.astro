---
import '@fontsource-variable/baloo-2';
import '@fontsource-variable/nunito';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import Icon from '../../../components/Icon.astro';
import PetArt from '../../../components/demo/art/PetArt.astro';
import { services, sizes, extras, days, hours, bookable, promises, money } from '../../../data/demos/tocamansa.js';
import '../../../styles/demos/tocamansa.css';

const nav = [
  ['#servicos', 'Serviços'],
  ['#precos', 'Preços'],
  ['#agendar', 'Agendar'],
  ['#visite', 'Visite'],
];
---

<DemoLayout
  title="Pet shop (demonstração) — Lade Group"
  description="Demonstração com marca fictícia de um site de pet shop com serviços, estimativa de preço do banho e agendamento de horário."
  kind="site"
  name="Pet shop"
>
  <div class="tm" id="topo">
    <header class="tm-top">
      <div class="tm-top-inner">
        <a class="tm-logo" href="#topo">
          <span class="tm-logo-mark"><Icon name="paw" /></span>
          Toca Mansa
        </a>
        <nav class="tm-nav" aria-label="Seções do site">
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <a class="tm-btn is-small" href="#agendar">Agendar</a>
      </div>
    </header>

    <section class="tm-hero">
      <div class="tm-hero-copy">
        <p class="tm-pill">Pet shop e banho e tosa</p>
        <h1>Quem espera você em casa merece um cuidado <span>de verdade.</span></h1>
        <p class="tm-lead">Banho, tosa, consulta e hotelzinho com hora marcada, calma e muito carinho. Você escolhe o horário e a gente cuida do resto.</p>
        <div class="tm-actions">
          <a class="tm-btn" href="#agendar">Agendar um horário</a>
          <a class="tm-btn is-ghost" href="#precos">Ver quanto custa</a>
        </div>
      </div>
      <div class="tm-hero-art" aria-hidden="true">
        <div class="tm-blob"></div>
        <PetArt kind="dog" class="tm-dog" />
        <PetArt kind="cat" class="tm-cat" />
        <span class="tm-sticker is-one">Sem fila!</span>
        <span class="tm-sticker is-two">Foto no fim</span>
      </div>
    </section>

    <div class="tm-wave is-paper" aria-hidden="true">
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none"><path d="M0 30c120-40 240-40 360 0s240 40 360 0 240-40 360 0 240 40 360 0V60H0Z" fill="currentColor"></path></svg>
    </div>

    <section class="tm-section" id="servicos" aria-labelledby="titulo-servicos">
      <div class="tm-wrap">
        <h2 id="titulo-servicos">Tudo para o seu bichinho em um lugar só</h2>
        <div class="tm-services">
          {
            services.map((service) => (
              <article class={`tm-card is-${service.tone}`}>
                <span class="tm-card-icon"><Icon name={service.icon} /></span>
                <h3>{service.name}</h3>
                <p>{service.text}</p>
              </article>
            ))
          }
        </div>
        <ul class="tm-promises">
          {promises.map((item) => <li><strong>{item.title}</strong><span>{item.text}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="tm-section is-tint" id="precos" aria-labelledby="titulo-precos">
      <div class="tm-wrap">
        <h2 id="titulo-precos">Quanto custa o banho?</h2>
        <p class="tm-sub">Monte a estimativa e veja o valor e o tempo aproximado. Valores de exemplo.</p>
        <div class="tm-calc">
          <form class="tm-calc-form" id="calc">
            <fieldset>
              <legend>Porte do pet</legend>
              <div class="tm-options">
                {
                  sizes.map((size, index) => (
                    <label class="tm-option">
                      <input type="radio" name="size" value={size.id} data-label={size.label} data-price={size.price} data-minutes={size.minutes} checked={index === 0} />
                      <span><b>{size.label}</b><small>{size.hint}</small><em>{money(size.price)}</em></span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <fieldset>
              <legend>Adicionais</legend>
              <div class="tm-extras">
                {
                  extras.map((extra) => (
                    <label class="tm-check">
                      <input type="checkbox" name="extra" value={extra.id} data-label={extra.label} data-price={extra.price} data-minutes={extra.minutes} />
                      <span>{extra.label}</span>
                      <em>+ {money(extra.price)}</em>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </form>
          <aside class="tm-result" aria-live="polite">
            <p class="tm-result-label">Estimativa</p>
            <strong id="calc-total">R$ 0,00</strong>
            <p id="calc-time">Tempo aproximado: 1 h</p>
            <ul id="calc-list"></ul>
            <a class="tm-btn is-dark" href="#agendar">Agendar com esse serviço</a>
          </aside>
        </div>
      </div>
    </section>

    <section class="tm-section" id="agendar" aria-labelledby="titulo-agendar">
      <div class="tm-wrap tm-book">
        <div>
          <h2 id="titulo-agendar">Escolha um horário</h2>
          <p class="tm-sub">Escolha o dia e o horário livre. Nesta demonstração nada é enviado: o resumo aparece só aqui na página.</p>
          <form class="tm-form" id="booking" novalidate>
            <div class="tm-fields">
              <label>Seu nome<input name="tutor" autocomplete="off" maxlength="60" /></label>
              <label>Nome do pet<input name="pet" autocomplete="off" maxlength="40" /></label>
            </div>
            <label>
              Serviço
              <select name="service">{bookable.map((item) => <option value={item.label}>{item.label}</option>)}</select>
            </label>
            <fieldset>
              <legend>Dia</legend>
              <div class="tm-chips" id="days">
                {days.map((day) => <button type="button" data-day={day} aria-pressed="false">{day}</button>)}
              </div>
            </fieldset>
            <fieldset>
              <legend>Horário</legend>
              <div class="tm-chips" id="hours">
                {hours.map((hour) => <button type="button" data-hour={hour} aria-pressed="false" disabled>{hour}</button>)}
              </div>
            </fieldset>
            <p class="tm-error" id="book-error" role="alert" hidden></p>
            <button type="submit" class="tm-btn">Reservar horário</button>
          </form>
          <div class="tm-confirm" id="confirm" role="status" hidden>
            <h3>Horário reservado!</h3>
            <p id="confirm-text"></p>
            <button type="button" class="tm-btn is-ghost" id="again">Fazer outra reserva</button>
          </div>
        </div>
        <div class="tm-book-art" aria-hidden="true">
          <PetArt kind="cat" class="tm-book-cat" />
          <p>Chegue 10 minutos antes. A primeira visita sempre tem tempo extra para o pet se acostumar.</p>
        </div>
      </div>
    </section>

    <footer class="tm-foot" id="visite">
      <div class="tm-wrap tm-foot-grid">
        <div>
          <strong class="tm-foot-name">Toca Mansa</strong>
          <p>Avenida dos Ipês, 450 · Cidade Exemplo</p>
        </div>
        <div>
          <strong>Horário</strong>
          <p>Segunda a sábado, das 9h às 18h</p>
        </div>
        <div>
          <strong>Telefone</strong>
          <p>(00) 0000-0000</p>
        </div>
      </div>
      <p class="tm-fine">Toca Mansa é uma marca fictícia criada pela Lade Group para esta demonstração.</p>
    </footer>
  </div>

  <script>
    import '../../../scripts/demos/tocamansa.js';
  </script>
</DemoLayout>
