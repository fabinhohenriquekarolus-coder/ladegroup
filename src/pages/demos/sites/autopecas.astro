---
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import condensedBold from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import condensedSemi from '@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url';
import bodyRegular from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import Icon from '../../../components/Icon.astro';
import { categories, lines, parts, kpis, benefits, tiers, money } from '../../../data/demos/eixonorte.js';
import '../../../styles/demos/eixonorte.css';

const lineLabel = { leve: 'Leve', pesada: 'Pesada' };
const stockState = (stock) => (stock === 0 ? 'is-order' : stock < 50 ? 'is-low' : 'is-ok');
const stockLabel = (stock) => (stock === 0 ? 'Sob encomenda' : `${stock} un`);
---

<DemoLayout
  title="Autopeças B2B (demonstração) — Lade Group"
  description="Demonstração com marca fictícia de um site de autopeças para lojistas, com catálogo filtrável, estoque por código e cotação com desconto por volume."
  kind="site"
  name="Autopeças B2B"
>
  <Fragment slot="head">
    <link rel="preload" as="font" type="font/woff2" href={condensedBold} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={condensedSemi} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyRegular} crossorigin />
  </Fragment>
  <div class="en" id="topo" data-tiers={JSON.stringify(tiers)}>
    <div class="en-util">
      <span>Atendimento ao lojista: (00) 0000-0000 · seg a sex, 7h30 às 18h</span>
      <span>Venda exclusiva para empresas</span>
    </div>

    <header class="en-head">
      <a class="en-logo" href="#topo">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path d="M16 2 28 9v14l-12 7L4 23V9Z" fill="#ff6a00"></path>
          <path d="M16 8v16M9 12l7-4 7 4" fill="none" stroke="#1b242c" stroke-width="3" stroke-linecap="square"></path>
        </svg>
        <span>Eixo Norte<small>Autopeças</small></span>
      </a>
      <form class="en-search" role="search" id="search-form">
        <label class="sr-only" for="q">Buscar por código, peça ou aplicação</label>
        <input id="q" type="search" placeholder="Código, peça ou aplicação" autocomplete="off" />
      </form>
      <div class="en-head-actions">
        <button type="button" class="en-ghost" data-demo-action="Nesta demonstração não há área do lojista.">Área do lojista</button>
        <a class="en-quote-link" href="#cotacao">Cotação <b id="quote-count">0</b></a>
      </div>
    </header>

    <section class="en-hero">
      <div class="en-hero-inner">
        <p class="en-kicker">Distribuidora para oficinas e lojas</p>
        <h1>A peça certa para a sua oficina, com o estoque na tela.</h1>
        <p class="en-lead">Consulte código, aplicação e disponibilidade antes de pedir. Preço de lojista, desconto por volume e entrega programada.</p>
        <ul class="en-kpis">
          {kpis.map((kpi) => <li><strong>{kpi.value}</strong><span>{kpi.label}</span></li>)}
        </ul>
      </div>
    </section>
    <div class="en-hazard" aria-hidden="true"></div>

    <main class="en-main" id="catalogo">
      <div class="en-layout">
        <section aria-labelledby="titulo-catalogo">
          <div class="en-bar">
            <h2 id="titulo-catalogo">Catálogo para lojistas</h2>
            <p class="en-count" id="count" aria-live="polite">15 itens</p>
          </div>

          <div class="en-filters">
            <div class="en-chips" role="group" aria-label="Categoria">
              {categories.map((cat, index) => <button type="button" data-cat={cat.id} aria-pressed={index === 0 ? 'true' : 'false'}>{cat.label}</button>)}
            </div>
            <label class="en-select">
              <span class="sr-only">Linha de veículos</span>
              <select id="line">{lines.map((line) => <option value={line.id}>{line.label}</option>)}</select>
            </label>
            <label class="en-toggle"><input type="checkbox" id="only-stock" /><span>Só com estoque</span></label>
          </div>

          <div class="en-table-wrap">
            <table class="en-table">
              <thead>
                <tr>
                  <th scope="col">Código</th>
                  <th scope="col">Peça</th>
                  <th scope="col">Aplicação</th>
                  <th scope="col">Linha</th>
                  <th scope="col">Estoque</th>
                  <th scope="col" class="num">Tabela</th>
                  <th scope="col">Qtd</th>
                  <th scope="col"><span class="sr-only">Ação</span></th>
                </tr>
              </thead>
              <tbody id="parts">
                {
                  parts.map((part) => (
                    <tr class="part" data-code={part.code} data-name={part.name} data-app={part.app} data-cat={part.cat} data-line={part.line} data-stock={part.stock} data-price={part.price}>
                      <td data-label="Código" class="code">{part.code}</td>
                      <td data-label="Peça"><strong>{part.name}</strong></td>
                      <td data-label="Aplicação" class="app">{part.app}</td>
                      <td data-label="Linha">{lineLabel[part.line]}</td>
                      <td data-label="Estoque"><span class={`stock ${stockState(part.stock)}`}>{stockLabel(part.stock)}</span></td>
                      <td data-label="Tabela" class="num">{money(part.price)}</td>
                      <td data-label="Qtd"><input class="qty" type="number" min="1" max="999" value="1" inputmode="numeric" aria-label={`Quantidade de ${part.code}`} /></td>
                      <td class="act"><button type="button" class="en-add" data-add>Cotar</button></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="en-empty" id="empty" hidden>Nenhuma peça encontrada. Tente outro código ou limpe os filtros.</p>
          <p class="en-note">Desconto por volume, por código: 10 ou mais unidades, 5%. 50 ou mais, 8%. Itens sob encomenda chegam em até 5 dias úteis.</p>
        </section>

        <aside class="en-quote" id="cotacao" aria-labelledby="titulo-cotacao">
          <h2 id="titulo-cotacao">Sua cotação</h2>
          <p class="en-quote-empty" id="quote-empty">Nenhum item ainda. Use “Cotar” no catálogo.</p>
          <ul class="en-quote-lines" id="quote-lines"></ul>
          <dl class="en-sums">
            <div><dt>Subtotal</dt><dd id="sum-sub">R$ 0,00</dd></div>
            <div><dt>Desconto por volume</dt><dd id="sum-disc">R$ 0,00</dd></div>
            <div class="is-total"><dt>Total</dt><dd id="sum-total">R$ 0,00</dd></div>
          </dl>
          <form id="quote-form" novalidate>
            <label>
              CNPJ da empresa
              <input id="cnpj" name="cnpj" inputmode="numeric" autocomplete="off" placeholder="00.000.000/0000-00" maxlength="18" />
            </label>
            <p class="en-error" id="quote-error" role="alert" hidden></p>
            <button type="submit" class="en-send">Solicitar cotação</button>
          </form>
          <p class="en-fine-print">Nesta demonstração nada é enviado e nenhum CNPJ é guardado.</p>
        </aside>
      </div>
    </main>

    <section class="en-benefits" aria-labelledby="titulo-beneficios">
      <div class="en-wrap">
        <h2 id="titulo-beneficios">Como funciona para lojistas</h2>
        <ul class="en-benefit-grid">
          {benefits.map((item) => <li><span class="en-benefit-icon"><Icon name={item.icon} /></span><h3>{item.title}</h3><p>{item.text}</p></li>)}
        </ul>
      </div>
    </section>

    <footer class="en-foot">
      <div class="en-wrap en-foot-grid">
        <div>
          <strong class="en-foot-name">Eixo Norte Autopeças</strong>
          <p>Av. das Indústrias, 2300 · Cidade Exemplo</p>
        </div>
        <div>
          <strong>Atendimento</strong>
          <p>Segunda a sexta, das 7h30 às 18h</p>
        </div>
        <div>
          <strong>Telefone</strong>
          <p>(00) 0000-0000</p>
        </div>
      </div>
      <p class="en-fine">Eixo Norte Autopeças é uma marca fictícia criada pela Lade Group para esta demonstração. Códigos, preços e estoques são exemplos.</p>
    </footer>
  </div>

  <script>
    import '../../../scripts/demos/eixonorte.js';
  </script>
</DemoLayout>
