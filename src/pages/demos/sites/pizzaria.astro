---
import '@fontsource/alfa-slab-one/400.css';
import '@fontsource-variable/dm-sans';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import PizzaArt from '../../../components/demo/art/PizzaArt.astro';
import { sizes, categories, dishes, neighborhoods, steps, money } from '../../../data/demos/fornalha.js';
import '../../../styles/demos/fornalha.css';

const lowest = Math.min(...dishes.filter((dish) => dish.art).map((dish) => dish.media));
const nav = [
  ['#cardapio', 'Cardápio'],
  ['#como', 'Como pedir'],
  ['#entrega', 'Entrega'],
  ['#contato', 'Endereço'],
];
---

<DemoLayout
  title="Pizzaria e delivery (demonstração) — Lade Group"
  description="Demonstração com marca fictícia de um site de pizzaria e delivery com cardápio, pedido e taxa de entrega por bairro."
  kind="site"
  name="Pizzaria e delivery"
>
  <div class="fv" id="topo">
    <header class="fv-top">
      <div class="fv-top-inner">
        <a class="fv-logo" href="#topo">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M16 2c1.4 6 8 8.6 8 16.2A8 8 0 0 1 8 18c0-3.2 1.4-5.2 3.1-7 .6 2.4 1.9 3.5 3.3 3.8.4-5 .3-8.6 1.6-12.8Z" fill="#ff8a1f"></path>
            <path d="M16 15c.7 2.4 4 3.6 4 7.4a4 4 0 0 1-8 0c0-1.8.9-2.8 1.8-3.6.4 1 1.2 1.4 1.7 1.5.5-2.2.2-3.7.5-5.3Z" fill="#fff4df"></path>
          </svg>
          Fornalha Vivo
        </a>
        <nav class="fv-nav" aria-label="Seções do site">
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <a class="fv-cart-link" href="#pedido">
          Pedido <b id="cart-count">0</b><span id="cart-top">R$ 0,00</span>
        </a>
      </div>
    </header>

    <div class="fv-hero-wrap">
    <section class="fv-hero">
      <div class="fv-hero-copy">
        <p class="fv-kicker">Pizzaria a lenha · delivery</p>
        <h1>Massa de 48 horas, forno a lenha e na sua porta.</h1>
        <p class="fv-lead">Ingredientes frescos, pizza saindo do forno a 400 °C e um pedido que você monta em dois minutos.</p>
        <div class="fv-actions">
          <a class="fv-btn is-fire" href="#cardapio">Ver cardápio</a>
          <button type="button" class="fv-btn is-line" data-demo-action="Nesta demonstração, o botão não abre uma conversa real.">Pedir pelo WhatsApp</button>
        </div>
        <p class="fv-from">Pizza média a partir de <strong>{money(lowest)}</strong></p>
      </div>
      <div class="fv-hero-art">
        <PizzaArt variant="calabresa" class="fv-hero-pizza" />
        <span class="fv-stamp">Massa<br />48 h</span>
      </div>
    </section>
    </div>

    <div class="fv-strip" aria-hidden="true">
      <span>Forno a lenha</span><i></i><span>Massa de longa fermentação</span><i></i><span>Entrega própria</span><i></i><span>Ingredientes frescos</span>
    </div>

    <section class="fv-menu" id="cardapio" aria-labelledby="titulo-cardapio">
      <div class="fv-wrap">
        <div class="fv-menu-head">
          <h2 id="titulo-cardapio">Cardápio</h2>
          <div class="fv-controls">
            <div class="fv-tabs" role="group" aria-label="Categoria">
              {categories.map((cat, index) => <button type="button" data-cat={cat.id} aria-pressed={index === 0 ? 'true' : 'false'}>{cat.label}</button>)}
            </div>
            <div class="fv-sizes" id="sizes" role="group" aria-label="Tamanho da pizza">
              {sizes.map((size, index) => <button type="button" data-size={size.id} aria-pressed={index === 0 ? 'true' : 'false'}>{size.label}<small>{size.note}</small></button>)}
            </div>
          </div>
        </div>

        <div class="fv-layout">
          <div class="fv-dishes" id="dishes">
            {
              dishes.map((dish) => (
                <article class="dish" data-id={dish.id} data-cat={dish.cat} data-name={dish.name} data-media={dish.media} data-grande={dish.grande ?? ''} hidden={dish.cat !== 'salgadas'}>
                  {
                    dish.art ? (
                      <PizzaArt variant={dish.art} class="dish-art" />
                    ) : (
                      <svg class="dish-art dish-drink" viewBox="0 0 64 64" aria-hidden="true">
                        <path d="M18 14h28l-3 38a4 4 0 0 1-4 4H25a4 4 0 0 1-4-4Z" fill="#fff4df" stroke="#1a1412" stroke-width="3" stroke-linejoin="round"></path>
                        <path d="M20 26h24" stroke="#1a1412" stroke-width="3"></path>
                        <path d="M36 14 42 4" stroke="#e0401f" stroke-width="4" stroke-linecap="round"></path>
                      </svg>
                    )
                  }
                  <div class="dish-body">
                    <h3>{dish.name}</h3>
                    <p>{dish.desc}</p>
                    <div class="dish-foot">
                      <strong class="dish-price">{money(dish.media)}</strong>
                      <button type="button" class="dish-add" data-add>Adicionar</button>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <aside class="fv-cart" id="pedido" aria-labelledby="titulo-pedido">
            <h2 id="titulo-pedido">Seu pedido</h2>
            <ul class="cart-lines" id="cart-lines"></ul>
            <p class="cart-empty" id="cart-empty">Ainda vazio. Escolha uma pizza no cardápio.</p>
            <label class="cart-field">
              Bairro de entrega
              <select id="bairro">
                <option value="">Escolha o bairro</option>
                {neighborhoods.map((n) => <option value={n.id} data-fee={n.fee} data-time={n.time}>{n.name}</option>)}
              </select>
            </label>
            <dl class="cart-sum">
              <div><dt>Subtotal</dt><dd id="subtotal">R$ 0,00</dd></div>
              <div><dt>Entrega</dt><dd id="fee">—</dd></div>
              <div class="is-total"><dt>Total</dt><dd id="total">R$ 0,00</dd></div>
            </dl>
            <p class="cart-eta" id="eta">Escolha o bairro para ver o prazo.</p>
            <button type="button" class="fv-btn is-fire" id="checkout" disabled>Finalizar pedido</button>
          </aside>
        </div>
      </div>
    </section>

    <section class="fv-how" id="como" aria-labelledby="titulo-como">
      <div class="fv-wrap">
        <h2 id="titulo-como">Como pedir</h2>
        <ol class="fv-steps">
          {steps.map((step, index) => <li><b>{index + 1}</b><h3>{step.title}</h3><p>{step.text}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="fv-delivery" id="entrega" aria-labelledby="titulo-entrega">
      <div class="fv-wrap fv-delivery-grid">
        <div>
          <h2 id="titulo-entrega">Onde entregamos</h2>
          <p>Taxa e prazo por bairro. Pedidos feitos até 22h30 chegam quentes.</p>
        </div>
        <table class="fv-table">
          <thead><tr><th scope="col">Bairro</th><th scope="col">Taxa</th><th scope="col">Prazo</th></tr></thead>
          <tbody>
            {neighborhoods.map((n) => <tr><th scope="row">{n.name}</th><td>{money(n.fee)}</td><td>{n.time}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <footer class="fv-foot" id="contato">
      <div class="fv-wrap fv-foot-grid">
        <div>
          <strong class="fv-foot-name">Fornalha Vivo</strong>
          <p>Rua das Palmeiras, 120 · Cidade Exemplo</p>
        </div>
        <div>
          <strong>Horário</strong>
          <p>Terça a domingo, das 18h às 23h</p>
        </div>
        <div>
          <strong>Telefone</strong>
          <p>(00) 0000-0000</p>
        </div>
      </div>
      <p class="fv-fine">Fornalha Vivo é uma marca fictícia criada pela Lade Group para esta demonstração.</p>
    </footer>
  </div>

  <script>
    import '../../../scripts/demos/fornalha.js';
  </script>
</DemoLayout>
