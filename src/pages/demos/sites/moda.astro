---
import '@fontsource-variable/syne';
import '@fontsource-variable/manrope';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import GarmentArt from '../../../components/demo/art/GarmentArt.astro';
import { colors, categories, sizes, products, looks, promises, freeShipping, money } from '../../../data/demos/meialuz.js';
import '../../../styles/demos/meialuz.css';

const nav = [
  ['#colecao', 'Coleção'],
  ['#lookbook', 'Lookbook'],
  ['#atelie', 'Ateliê'],
];
---

<DemoLayout
  title="Loja de moda (demonstração) — Lade Group"
  description="Demonstração com marca fictícia de uma loja de moda com coleção filtrável, escolha de cor e tamanho e sacola de compras."
  kind="site"
  name="Loja de moda"
>
  <div class="ml" id="ml" data-free={freeShipping}>
    <div class="ml-strip"><span>Frete grátis acima de R$ 350</span><span>Troca em 30 dias</span><span>Séries pequenas</span></div>

    <header class="ml-head">
      <nav class="ml-nav" aria-label="Seções do site">
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <a class="ml-mark" href="#ml">Meia-Luz<small>ateliê</small></a>
      <div class="ml-tools">
        <button type="button" class="ml-bag-btn" id="open-bag" aria-haspopup="dialog">Sacola <b id="bag-count">0</b></button>
      </div>
    </header>

    <main>
      <section class="ml-hero">
        <div class="ml-hero-copy">
          <p class="ml-no">Coleção nº 07 · Entretempo</p>
          <h1>Roupa para o dia que ainda não escolheu o clima.</h1>
          <p class="ml-lead">Peças de corte limpo e tecidos leves, pensadas para trocar de camada sem trocar de ideia.</p>
          <a class="ml-link" href="#colecao">Ver a coleção <span aria-hidden="true">→</span></a>
        </div>
        <div class="ml-hero-art" aria-hidden="true">
          <div class="ml-panel is-one"><span>01</span><GarmentArt kind="dress" class="ml-hero-garment" /></div>
          <div class="ml-panel is-two"><span>02</span><GarmentArt kind="coat" class="ml-hero-garment" /></div>
          <div class="ml-panel is-three"><span>03</span><GarmentArt kind="bag" class="ml-hero-garment" /></div>
        </div>
      </section>

      <div class="ml-ribbon" aria-hidden="true">
        <span>Entretempo</span><i></i><span>Entretempo</span><i></i><span>Entretempo</span><i></i><span>Entretempo</span>
      </div>

      <section class="ml-shop" id="colecao" aria-labelledby="titulo-colecao">
        <div class="ml-wrap">
          <div class="ml-shop-head">
            <h2 id="titulo-colecao">A coleção</h2>
            <p class="ml-count" id="count" aria-live="polite">12 peças</p>
          </div>
          <div class="ml-filters" role="group" aria-label="Categoria">
            {categories.map((cat, index) => <button type="button" data-cat={cat.id} aria-pressed={index === 0 ? 'true' : 'false'}>{cat.label}</button>)}
          </div>

          <div class="ml-grid" id="grid">
            {
              products.map((product) => (
                <article class="item" data-id={product.id} data-cat={product.cat} data-name={product.name} data-price={product.price} style={`--g:${colors[product.colors[0]].hex}`}>
                  <div class="item-art" style={`background:${product.tile}`}>
                    <GarmentArt kind={product.art} class="item-garment" />
                    <button type="button" class="item-fav" aria-pressed="false" aria-label={`Favoritar ${product.name}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.6 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"></path></svg>
                    </button>
                    <button type="button" class="item-add" data-add>Adicionar à sacola</button>
                  </div>
                  <div class="item-info">
                    <h3>{product.name}</h3>
                    <span class="item-price">{money(product.price)}</span>
                  </div>
                  <div class="item-opts">
                    <div class="swatches" role="group" aria-label="Cor">
                      {
                        product.colors.map((key, index) => (
                          <button type="button" class="swatch" data-color={key} data-hex={colors[key].hex} aria-pressed={index === 0 ? 'true' : 'false'} aria-label={colors[key].name} style={`--s:${colors[key].hex}`}></button>
                        ))
                      }
                    </div>
                    <div class="sizes" role="group" aria-label="Tamanho">
                      {sizes.map((size, index) => <button type="button" data-size={size} aria-pressed={index === 1 ? 'true' : 'false'}>{size}</button>)}
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="ml-look" id="lookbook" aria-labelledby="titulo-look">
        <div class="ml-wrap">
          <h2 id="titulo-look">Lookbook</h2>
          <div class="ml-looks">
            {
              looks.map((look) => (
                <figure class="look" style={`--bg:${look.bg}`}>
                  <div class="look-art" aria-hidden="true">
                    <GarmentArt kind={look.art[0]} class="look-a" style={`--g:${look.tones[0]}`} />
                    <GarmentArt kind={look.art[1]} class="look-b" style={`--g:${look.tones[1]}`} />
                  </div>
                  <figcaption><b>Look {look.no}</b><strong>{look.title}</strong><span>{look.text}</span></figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section class="ml-atelie" id="atelie" aria-labelledby="titulo-atelie">
        <div class="ml-wrap">
          <h2 id="titulo-atelie">Feito com calma</h2>
          <ol class="ml-promises">
            {promises.map((item, index) => <li><b>{`0${index + 1}`}</b><h3>{item.title}</h3><p>{item.text}</p></li>)}
          </ol>
        </div>
      </section>
    </main>

    <footer class="ml-foot">
      <div class="ml-wrap ml-foot-grid">
        <p class="ml-foot-mark">Meia-Luz</p>
        <p>Rua das Oficinas, 77 · Cidade Exemplo<br />Segunda a sábado, das 10h às 19h</p>
        <p>(00) 0000-0000</p>
      </div>
      <p class="ml-fine">Ateliê Meia-Luz é uma marca fictícia criada pela Lade Group para esta demonstração.</p>
    </footer>
  </div>

  <div class="ml-scrim" id="scrim" hidden></div>
  <aside class="ml-bag" id="bag" role="dialog" aria-modal="true" aria-labelledby="titulo-sacola" hidden>
    <header class="ml-bag-head">
      <h2 id="titulo-sacola">Sacola</h2>
      <button type="button" id="close-bag">Fechar</button>
    </header>
    <p class="ml-bag-empty" id="bag-empty">Sua sacola está vazia.</p>
    <ul class="ml-bag-lines" id="bag-lines"></ul>
    <footer class="ml-bag-foot">
      <p class="ml-ship" id="ship"></p>
      <div class="ml-meter" aria-hidden="true"><i id="meter"></i></div>
      <div class="ml-bag-total"><span>Total</span><strong id="bag-total">R$ 0,00</strong></div>
      <button type="button" class="ml-checkout" id="bag-checkout" disabled>Finalizar compra</button>
    </footer>
  </aside>

  <script>
    import '../../../scripts/demos/meialuz.js';
  </script>
</DemoLayout>
