---
import '@fontsource-variable/space-grotesk';
import '../styles/demos/demo-base.css';
import DemoBar from '../components/demo/DemoBar.astro';

const { title, description, kind, name, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0D0D0D" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class={bodyClass}>
    <a class="demo-skip" href="#demo">Ir para a demonstração</a>
    <DemoBar kind={kind} name={name} />
    <div id="demo">
      <slot />
    </div>
    <div class="demo-badge" aria-hidden="true"><span class="demo-badge-dot"></span>Demonstração</div>
    <script>
      import '../scripts/demos/toast.js';
    </script>
  </body>
</html>
